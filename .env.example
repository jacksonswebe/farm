# =====================================================================
# SafeSphere EHS — environment variables
# Copy to .env.local for development. Never commit a filled-in copy.
# =====================================================================

# --- Core ------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=SafeSphere EHS
LOG_LEVEL=debug

# --- Database --------------------------------------------------------
# The application user must NOT have BYPASSRLS — tenant isolation depends on it.
DATABASE_URL=postgresql://safesphere_app:changeme@localhost:5432/safesphere
# Separate privileged role used only by migrations
MIGRATION_DATABASE_URL=postgresql://safesphere_migrate:changeme@localhost:5432/safesphere
# PgBouncer must run in TRANSACTION pooling mode (withTenant uses SET LOCAL)
DATABASE_POOL_MAX=10

# --- Auth ------------------------------------------------------------
AUTH_SECRET=                       # openssl rand -base64 32
AUTH_URL=http://localhost:3000
SESSION_IDLE_TIMEOUT_HOURS=12
SESSION_ABSOLUTE_TIMEOUT_DAYS=30
# Key for app-level AES-256-GCM encryption of anonymous reporter contacts
FIELD_ENCRYPTION_KEY=              # openssl rand -hex 32

# --- File storage (Cloudflare R2 / any S3-compatible) ----------------
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=safesphere-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_PUT_EXPIRY_SECONDS=300
S3_PRESIGN_GET_EXPIRY_SECONDS=900
MAX_UPLOAD_BYTES=15728640          # 15 MB

# --- Email (Resend) --------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="SafeSphere EHS <no-reply@safesphere.io>"
MAIL_REPLY_TO=support@safesphere.io

# --- AI (Anthropic) --------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_REQUEST_TIMEOUT_MS=20000
AI_DEFAULT_ORG_MONTHLY_BUDGET_USD=25

# --- WhatsApp (Meta Cloud API) — Sprint 5 ----------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=               # verifies X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=             # Meta webhook subscription challenge
WHATSAPP_SESSION_TTL_MINUTES=30

# --- Payments — Sprint 5 ---------------------------------------------
PAYMENT_PROVIDER=stripe            # stripe | flutterwave | manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Jobs (pg-boss) --------------------------------------------------
JOBS_ENABLED=true                  # false on web-only containers
JOBS_SCHEMA=pgboss
JOBS_CONCURRENCY=5

# --- Observability ---------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# --- Rate limits (requests / window) ---------------------------------
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_ANON_REPORT_PER_HOUR=10
RATE_LIMIT_AI_PER_HOUR=60

# --- Feature flags ---------------------------------------------------
FEATURE_AI=true
FEATURE_WHATSAPP=false
FEATURE_BILLING=false
FEATURE_ANONYMOUS_REPORTING=true
