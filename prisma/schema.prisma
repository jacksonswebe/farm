generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_extensions {
  id                                                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                                     String        @db.Uuid
  action_id                                           String        @db.Uuid
  requested_by_user_id                                String?       @db.Uuid
  previous_due_date                                   DateTime      @db.Date
  requested_due_date                                  DateTime      @db.Date
  reason                                              String
  decided_by_user_id                                  String?       @db.Uuid
  decided_at                                          DateTime?     @db.Timestamptz(6)
  approved                                            Boolean?
  decision_comments                                   String?
  created_at                                          DateTime      @default(now()) @db.Timestamptz(6)
  actions                                             actions       @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_action_extensions_decided_by_user_idTousers   users?        @relation("action_extensions_decided_by_user_idTousers", fields: [decided_by_user_id], references: [id], onUpdate: NoAction)
  organizations                                       organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_action_extensions_requested_by_user_idTousers users?        @relation("action_extensions_requested_by_user_idTousers", fields: [requested_by_user_id], references: [id], onUpdate: NoAction)

  @@index([action_id, created_at(sort: Desc)], map: "action_extensions_action_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model action_updates {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id  String         @db.Uuid
  action_id        String         @db.Uuid
  user_id          String?        @db.Uuid
  note             String
  progress_percent Int?           @db.SmallInt
  status_from      action_status?
  status_to        action_status?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  actions          actions        @relation(fields: [action_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organizations    organizations  @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([action_id, created_at(sort: Desc)], map: "action_updates_action_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model actions {
  id                                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id                         String                   @db.Uuid
  reference                               String
  title                                   String
  description                             String?
  action_type                             action_type
  status                                  action_status            @default(OPEN)
  priority                                priority_level           @default(MEDIUM)
  hierarchy_level                         hierarchy_of_control
  incident_id                             String?                  @db.Uuid
  investigation_id                        String?                  @db.Uuid
  finding_id                              String?                  @db.Uuid
  root_cause_id                           String?                  @db.Uuid
  parent_action_id                        String?                  @db.Uuid
  site_id                                 String?                  @db.Uuid
  department_id                           String?                  @db.Uuid
  owner_user_id                           String                   @db.Uuid
  verifier_user_id                        String?                  @db.Uuid
  created_by_user_id                      String?                  @db.Uuid
  original_due_date                       DateTime                 @db.Date
  due_date                                DateTime                 @db.Date
  started_at                              DateTime?                @db.Timestamptz(6)
  submitted_at                            DateTime?                @db.Timestamptz(6)
  verified_at                             DateTime?                @db.Timestamptz(6)
  closed_at                               DateTime?                @db.Timestamptz(6)
  cancelled_reason                        String?
  effectiveness                           effectiveness_rating?
  verification_comments                   String?
  evidence_required                       Boolean                  @default(true)
  search_vector                           Unsupported("tsvector")?
  created_at                              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                              DateTime                 @default(now()) @db.Timestamptz(6)
  action_extensions                       action_extensions[]
  action_updates                          action_updates[]
  users_actions_created_by_user_idTousers users?                   @relation("actions_created_by_user_idTousers", fields: [created_by_user_id], references: [id], onUpdate: NoAction)
  departments                             departments?             @relation(fields: [department_id], references: [id], onUpdate: NoAction)
  findings                                findings?                @relation(fields: [finding_id], references: [id], onUpdate: NoAction)
  incidents                               incidents?               @relation(fields: [incident_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  investigations                          investigations?          @relation(fields: [investigation_id], references: [id], onUpdate: NoAction)
  organizations                           organizations            @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_actions_owner_user_idTousers      users                    @relation("actions_owner_user_idTousers", fields: [owner_user_id], references: [id], onUpdate: NoAction)
  actions                                 actions?                 @relation("actionsToactions", fields: [parent_action_id], references: [id], onUpdate: NoAction)
  other_actions                           actions[]                @relation("actionsToactions")
  root_causes                             root_causes?             @relation(fields: [root_cause_id], references: [id], onUpdate: NoAction)
  sites                                   sites?                   @relation(fields: [site_id], references: [id], onUpdate: NoAction)
  users_actions_verifier_user_idTousers   users?                   @relation("actions_verifier_user_idTousers", fields: [verifier_user_id], references: [id], onUpdate: NoAction)

  @@unique([organization_id, reference], map: "actions_reference_unique")
  @@index([incident_id], map: "actions_incident_idx")
  @@index([organization_id, created_at(sort: Desc), id(sort: Desc)], map: "actions_keyset_idx")
  @@index([organization_id, status, due_date], map: "actions_org_status_idx")
  @@index([owner_user_id, status, due_date], map: "actions_owner_idx")
  @@index([search_vector], map: "actions_search_idx", type: Gin)
  @@index([organization_id, site_id, due_date], map: "actions_site_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ai_interactions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  user_id         String?       @db.Uuid
  feature         ai_feature
  entity          entity_type?
  entity_id       String?       @db.Uuid
  model           String
