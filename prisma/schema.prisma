  users           users?        @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([organization_id, feature, outcome], map: "ai_interactions_feature_idx")
  @@index([organization_id, created_at(sort: Desc)], map: "ai_interactions_org_idx")
}

