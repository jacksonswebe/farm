{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/reminders.actions", "schedule": "0 6 * * *" },
    { "path": "/api/cron/escalations.actions", "schedule": "30 6 * * *" },
    { "path": "/api/cron/reminders.investigations", "schedule": "0 7 * * *" },
    { "path": "/api/cron/digest.weekly", "schedule": "0 5 * * 1" },
    { "path": "/api/cron/analytics.refresh", "schedule": "*/30 * * * *" },
    { "path": "/api/cron/attachments.cleanup", "schedule": "0 2 * * *" },
    { "path": "/api/cron/trial.check", "schedule": "0 3 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(self), microphone=()" }
      ]
    }
  ]
}
